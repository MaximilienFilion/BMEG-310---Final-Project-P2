library(clusterProfiler)
library(AnnotationDbi)
library(DESeq2)
library(pheatmap)
library(ggplot2)
library(cluster)
library(survival)
library(survminer)
#library(clusterProfiler)
library(org.Hs.eg.db) # Contains human gene annotations
library(dplyr)
library(tibble)
library(biomaRt)
## Get Initial Count Matrix
# Create count matrix (genes as rows, samples as columns)
count_matrix <- as.matrix(RNAseq_KIRC[, -1])  # Remove gene name column
# Assuming your Ensembl IDs are in the first column of RNAseq_KIRC
ensemble_ids <- RNAseq_KIRC[, 1]
# Fix common Ensembl ID format issue (remove version number like ".1")
# This ensures a better match rate with the annotation package
ensemble_ids_clean <- sub("\\.\\d+$", "", ensemble_ids)
rownames(count_matrix) <- ensemble_ids_clean
cat("Initial count matrix dimensions (by Ensembl ID):", dim(count_matrix), "\n")
# Map Ensembl IDs to Gene Symbols
gene_map <- select(
org.Hs.eg.db,
keys = rownames(count_matrix),
columns = c("SYMBOL"),
keytype = "ENSEMBL"
)
# Filter out Ensembl IDs that didn't map to a Gene Symbol
gene_map <- gene_map %>% filter(!is.na(SYMBOL))
# Handle one-to-many mappings (Multiple Ensembl IDs map to one Symbol)
# For simplicity, we keep the first occurrence of a symbol
gene_map <- gene_map %>%
distinct(ENSEMBL, .keep_all = TRUE) %>% # Keep one SYMBOL per ENSEMBL
distinct(SYMBOL, .keep_all = TRUE) # Keep one row per unique SYMBOL
cat("Number of unique Ensembl IDs mapped to a unique Symbol:", nrow(gene_map), "\n")
# Filter and Rename the Count Matrix
# Filter the count matrix to include only mapped genes
mapped_count_matrix <- count_matrix[gene_map$ENSEMBL, ]
# Assign the Gene Symbols as row names
rownames(mapped_count_matrix) <- gene_map$SYMBOL
cat("Final count matrix dimensions (by Gene Symbol):", dim(mapped_count_matrix), "\n")
# Filter out X and Y Chromosome Genes ---
# 1. Get chromosome information for the current gene set
# Note: Using Gene Symbols as keytype for a simpler mapping
gene_chr_map <- AnnotationDbi::select(
org.Hs.eg.db,
keys = rownames(mapped_count_matrix),
columns = c("CHR"),
keytype = "SYMBOL"
)
# 2. Identify Autosomal Genes (Chromosome 1-22)
# Exclude X, Y, MT (mitochondrial), and any unassigned/unknown chromosomes (NA)
# Autosomal chromosomes are '1' through '22'.
# We must first filter out NAs from the mapping step.
gene_chr_map <- gene_chr_map %>% filter(!is.na(CHR))
# Filter for only autosomes (1-22)
autosomal_gene_map <- gene_chr_map %>%
filter(CHR %in% as.character(1:22)) %>%
distinct(SYMBOL) # Keep only the unique autosomal symbols
# 3. Filter the count matrix to include only autosomal genes
autosomal_count_matrix <- mapped_count_matrix[autosomal_gene_map$SYMBOL, ]
cat("Number of genes removed (X, Y, MT, unassigned):",
nrow(mapped_count_matrix) - nrow(autosomal_count_matrix), "\n")
cat("Count matrix dimensions (Autosomal Genes x Samples):",
dim(autosomal_count_matrix), "\n")
# Reassign the count matrix variable to be used in the next step
count_data_to_filter <- autosomal_count_matrix
# Ensure the sample order in the matrix and metadata match perfectly
# Filter the symbol-mapped counts to match samples in metadata
# Use the autosomal count matrix
count_data_final <- count_data_to_filter[, sample_metadata$sample_id]
col_data_final <- sample_metadata
...
cat("Count matrix dimensions (Genes x Samples):", dim(count_data_final), "\n")
cat("Metadata dimensions (Samples x Variables):", dim(col_data_final), "\n")
cat("Samples included in DESeq2 analysis:", nrow(col_data_final), "\n")
print(table(col_data_final$sex))
cat("\n")
# 1c. Create the DESeq2 object with the design formula: ~ sex
dds_sex <- DESeqDataSetFromMatrix(
countData = count_data_final, # Now defined correctly
colData = col_data_final,
design = ~ sex
)
# Pre-filtering to remove genes with very low counts
# Remove more genes for efficiency and power
# Set the new minimum sample percentage (e.g., 50%)
min_percent_samples <- 0.50
# Calculate the minimum number of samples required
min_samps <- ceiling(min_percent_samples * ncol(dds_sex))
# Filtering criteria: require >=10 counts in at least 'min_samps' samples
keep <- rowSums(counts(dds_sex) >= 10) >= min_samps
dds_sex <- dds_sex[keep,]
cat(sum(!keep), "genes removed due to low counts (using 50% sample cutoff).\n")
cat("Remaining genes for DESeq2 analysis:", nrow(dds_sex), "\n")
# Run DESeq2
cat("Running DESeq analysis...\n")
dds_sex <- DESeq(dds_sex)
cat("DESeq analysis complete.\n\n")
# Extract the results: comparing the two levels of the 'sex' variable
# The comparison is 'Female' vs 'Male' if Female is the second factor level
results_sex <- results(dds_sex, name="sex_Male_vs_Female") # Adjust the 'name' based on your factor levels
# Filter and format results
results_df <- as.data.frame(results_sex) %>%
rownames_to_column("gene") %>%
filter(!is.na(padj)) %>% # Remove genes with NA p-values (often due to filtering or extreme values)
arrange(padj)
# Get the count of significant genes
significant_genes_deseq <- sum(results_df$padj < 0.05)
cat("Significant genes (FDR < 0.05) via DESeq2:", significant_genes_deseq, "\n")
cat("Top 10 most differentially expressed genes by sex:\n")
print(head(results_df, 10))
# Filter and format results
results_df <- as.data.frame(results_sex) %>%
rownames_to_column("gene") %>%
filter(!is.na(padj)) %>% # Remove genes with NA p-values
# Sort by the absolute value of log2FoldChange for max variability
arrange(desc(abs(log2FoldChange)))
# Get the count of significant genes
# Keep this part to assess DE significance
significant_genes_deseq <- sum(results_df$padj < 0.05)
cat("Significant autosomal genes (FDR < 0.05) via DESeq2:", significant_genes_deseq, "\n")
cat("Top 10 autosomal genes exhibiting the greatest variability in expression (by absolute log2FC):\n")
print(head(results_df, 10))
# Filter for significant genes (FDR < 0.05) first, then sort by LFC magnitude
top_variability_genes <- results_df %>%
filter(padj < 0.05) %>%
# Arrange by the absolute log2FoldChange in descending order
arrange(desc(abs(log2FoldChange)))
cat("Top 10 Autosomal Genes exhibiting the Greatest Variability (Highest |log2FC|):\n")
print(head(top_variability_genes, 10))
# Get the list of significant Gene Symbols (your 2106 genes)
sig_genes_symbols <- results_df %>%
filter(padj < 0.05) %>%
pull(gene)
# Convert Gene Symbols to Entrez IDs
sig_genes_entrez <- bitr(
sig_genes_symbols,
fromType = "SYMBOL",
toType = "ENTREZID",
OrgDb = org.Hs.eg.db
) %>%
pull(ENTREZID)
cat("Number of unique significant autosomal genes successfully mapped to Entrez ID:", length(sig_genes_entrez), "\n")
## --- GO Biological Process (BP) Enrichment ---
go_results <- enrichGO(
gene          = sig_genes_entrez,
OrgDb         = org.Hs.eg.db,
keyType       = "ENTREZID",
ont           = "BP", # Biological Process
pAdjustMethod = "BH",
pvalueCutoff  = 0.05,
qvalueCutoff  = 0.05,
readable      = TRUE # Converts Entrez ID back to Gene Symbol in results
)
## --- KEGG Pathway Enrichment ---
kegg_results <- enrichKEGG(
gene          = sig_genes_entrez,
organism      = 'hsa', # Homo sapiens KEGG code
keyType       = "entrez",
pAdjustMethod = "BH",
pvalueCutoff  = 0.05,
qvalueCutoff  = 0.05
)
# Optional: Convert KEGG Entrez IDs to Gene Symbols for readability
kegg_results <- setReadable(kegg_results, OrgDb = org.Hs.eg.db, keyType = "ENTREZID")
cat("\n--- Top 10 Enriched GO Biological Processes ---\n")
print(head(as.data.frame(go_results), 10))
cat("\n--- Top 10 Enriched KEGG Pathways ---\n")
print(head(as.data.frame(kegg_results), 10))
