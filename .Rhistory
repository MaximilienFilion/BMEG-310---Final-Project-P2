scale = "row",
main = "Heatmap of Top 50 Autosomal Sex-Biased Genes",
show_colnames = FALSE)
# 1. Select the top 20 most significant genes (by padj)
top_20_genes <- results_df %>%
filter(padj < 0.05) %>%
arrange(padj) %>%
head(20) # CHANGE 50 to 20
# 2. Get normalized, transformed counts from your DESeq2 object (dds_sex)
