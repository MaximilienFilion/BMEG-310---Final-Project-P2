library(pheatmap)
vst_mat <- assay(vst(dds_sex, blind=FALSE))
top20 <- results_df$gene[1:20]
pheatmap(vst_mat[top20, ], annotation_col = data.frame(sex = col_data_final$sex),
show_rownames = TRUE, show_colnames = FALSE, scale="row",
main = "Top 20 sex-variable autosomal genes")
