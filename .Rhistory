# --- Print GO Results ---
cat("\n--- Top 10 Enriched GO Biological Processes ---\n")
# Ensure go_results exists and has results
if (!is.null(go_results) && nrow(as.data.frame(go_results)) > 0) {
print(head(as.data.frame(go_results), 10))
} else {
cat("No significant GO terms found or GO analysis failed.\n")
}
# --- Print KEGG Results ---
cat("\n--- Top 10 Enriched KEGG Pathways ---\n")
# Check if kegg_results object was successfully created
if (exists("kegg_results") && !is.null(kegg_results) && nrow(as.data.frame(kegg_results)) > 0) {
print(head(as.data.frame(kegg_results), 10))
} else {
cat("KEGG analysis failed, likely due to a connection error (HTTP 400) or no significant pathways found.\n")
}
